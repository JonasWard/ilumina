---
import LanguageSelect from './LanguageSelect.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const t = useTranslations(locale, 'footer');
---

<footer class="bg-white/50 py-12 px-4">
  <p>{t('description')}</p>
  <p>
    <LanguageSelect locale={locale} path={path} />
  </p>
</footer>
