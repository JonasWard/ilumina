---
import '../styles/global.css';
import icon from '../../assets/icons/icon.svg?url';
import { LANGUAGE_TAGS, LOCALES, localizedPath } from '../i18n';
import { localeRedirectScript } from '../i18n/detect';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>ilumina</title>
    <link rel="icon" href={icon} type="image/svg+xml" />
    <script is:inline set:html={localeRedirectScript(base, '')} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LANGUAGE_TAGS[l]} href={new URL(localizedPath(l), Astro.site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en'), Astro.site).href} />
  </head>
  <body class="flex flex-col min-h-svh items-center justify-center text-center">
    <noscript>
      <ul class="flex flex-row gap-2 list-none p-0">
        {
          LOCALES.map((l) => (
            <li>
              <a href={localizedPath(l)} lang={LANGUAGE_TAGS[l]} class="grid place-items-center min-h-11 min-w-11 px-3 underline">
                {l}
              </a>
            </li>
          ))
        }
      </ul>
    </noscript>
  </body>
</html>
